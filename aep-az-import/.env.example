# AEP Data Landing Zone — SAS URI
# Copy this file to .env and fill in the value from your AEP Data Landing Zone credentials.
# Get the SAS URI from: AEP > Sources > Data Landing Zone > "View credentials"
#
# Format: https://<storage-account>.blob.core.windows.net/<container>?sv=...&sig=...
AZCOPY_SAS_URI=https://your-storage-account.blob.core.windows.net/dlz-user-container?sv=2020-04-08&si=dlz-...&sr=c&sp=racwdlm&sig=...
